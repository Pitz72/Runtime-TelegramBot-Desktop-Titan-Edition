{
    "name": "titan-desktop",
    "version": "2.5.0",
    "description": "Applicazione desktop per pubblicare automaticamente feed RSS, podcast e canali YouTube su Telegram",
    "author": {
        "name": "Simone Pizzi",
        "email": "info@runtimeradio.it"
    },
    "license": "MIT",
    "homepage": "https://github.com/Pitz72/Runtime-TelegramBot-Desktop-Titan-Edition",
    "repository": {
        "type": "git",
        "url": "https://github.com/Pitz72/Runtime-TelegramBot-Desktop-Titan-Edition.git"
    },
    "bugs": {
        "url": "https://github.com/Pitz72/Runtime-TelegramBot-Desktop-Titan-Edition/issues"
    },
    "keywords": [
        "telegram",
        "telegram-bot",
        "rss",
        "podcast",
        "youtube",
        "electron",
        "automation"
    ],
    "private": true,
    "type": "module",
    "main": "dist-electron/main/index.cjs",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && node scripts/third-party-notices.mjs && electron-builder",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check:locales": "node scripts/check-locales.mjs",
        "notices": "node scripts/third-party-notices.mjs",
        "preview:ui": "vite --config scripts/ui-preview/vite.config.ts",
        "check:contrast": "node scripts/check-contrast.mjs"
    },
    "dependencies": {
        "@electron-toolkit/utils": "^4.0.0",
        "@fontsource-variable/fira-code": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@tanstack/react-virtual": "^3.13.24",
        "better-sqlite3": "^13.0.3",
        "clsx": "^2.1.0",
        "electron-updater": "^6.8.11",
        "framer-motion": "^11.0.3",
        "lucide-react": "^0.316.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "rss-parser": "^3.13.0",
        "tailwind-merge": "^2.2.1",
        "telegraf": "^4.15.3",
        "youtubei.js": "^17.2.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.20.5",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "^10.4.17",
        "axe-core": "^4.14.0",
        "electron": "^44.9.3",
        "electron-builder": "^26.15.3",
        "jsdom": "^26.1.0",
        "postcss": "^8.4.33",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "vite-plugin-electron": "^1.1.2",
        "vite-plugin-electron-renderer": "^1.0.0",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
