# BotTelegramRSS - Configurazione Ambiente
# Copia questo file come .env e personalizza i valori

# ===== CONFIGURAZIONI OBBLIGATORIE =====

# Token del bot Telegram (ottenuto da @BotFather)
# Formato: 123456789:ABCdefGHIjklMNOpqrSTUvwxyz
BOT_TOKEN=your_telegram_bot_token_here

# ID del canale Telegram di destinazione
# Formato: @channel_username oppure -100123456789
CHANNEL_ID=@your_channel_name

# ===== CONFIGURAZIONI AMBIENTE =====

# Ambiente di esecuzione (development, testing, production)
ENVIRONMENT=production

# ===== CONFIGURAZIONI OPZIONALI =====

# Livello di logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Intervallo controllo feed in secondi (default: 1800 = 30 minuti)
FEED_CHECK_INTERVAL=1800

# Numero massimo tentativi per operazioni fallite
MAX_RETRIES=3

# Timeout richieste HTTP in secondi
REQUEST_TIMEOUT=30

# Delay tra messaggi Telegram in secondi (rate limiting)
MESSAGE_RATE_LIMIT=5

# ===== CONFIGURAZIONI DATABASE =====

# Nome file database episodi processati
PROCESSED_EPISODES_FILE=processed_episodes.json

# Abilita backup automatico database (true/false)
BACKUP_ENABLED=true

# Intervallo backup in secondi (default: 86400 = 24 ore)
BACKUP_INTERVAL=86400

# Directory backup (relativa o assoluta)
BACKUP_DIR=backups

# Numero massimo file backup da mantenere
MAX_BACKUP_FILES=30

# ===== CONFIGURAZIONI SICUREZZA =====

# Abilita validazione SSL per richieste HTTP (true/false)
VERIFY_SSL=true

# ===== CONFIGURAZIONI PERFORMANCE =====

# Timeout connessioni HTTP (secondi)
CONNECTION_TIMEOUT=30
READ_TIMEOUT=30
WRITE_TIMEOUT=30
CONNECT_TIMEOUT=30

# Cache Settings (ottimizzazioni performance)
CACHE_ENABLED=true
CACHE_TIMEOUT=300

# ===== CONFIGURAZIONI RELIABILITY =====

# Retry Logic per errori temporanei
RETRY_ATTEMPTS=3
RETRY_DELAY=5

# Health Check Monitoring
HEALTH_CHECK_INTERVAL=3600

# ===== CONFIGURAZIONI MONITORING =====

# Performance Metrics e Logging
ENABLE_METRICS=true
METRICS_LOG_INTERVAL=3600

# ===== ESEMPI CONFIGURAZIONI PER AMBIENTE =====

# Testing:
# ENVIRONMENT=testing
# LOG_LEVEL=DEBUG
# CHANNEL_ID=@test_channel
# PROCESSED_EPISODES_FILE=test_episodes.json
# FEED_CHECK_INTERVAL=300

# Production:
# ENVIRONMENT=production
# LOG_LEVEL=INFO
# FEED_CHECK_INTERVAL=1800
# BACKUP_ENABLED=true
# VERIFY_SSL=true

# ===== NOTE SICUREZZA =====
# 
# 1. Questo file contiene variabili sensibili e NON deve essere committato
# 2. Aggiungi .env al tuo .gitignore
# 3. I valori boolean devono essere 'true' o 'false' (minuscolo)
# 4. Per ottenere il token del bot, contatta @BotFather su Telegram
# 5. Per ottenere l'ID del canale, aggiungi @userinfobot al canale
# 6. Usa token diversi per test e produzione
# 7. Non condividere mai i token in chat/email 

# ===== NOTE OTTIMIZZAZIONE v0.8.1 =====
# 
# PERFORMANCE TIPS:
# - CACHE_ENABLED=true riduce richieste RSS duplicate  
# - FEED_CHECK_INTERVAL=1800 (30min) = 2x velocità vs 3600 (60min)
# - MESSAGE_RATE_LIMIT=5 evita rate limiting Telegram
# - CONNECTION_TIMEOUT=30 previene hang su feed lenti
#
# RELIABILITY TIPS:  
# - RETRY_ATTEMPTS=3 gestisce errori temporanei automaticamente
# - BACKUP_ENABLED=true previene perdita dati
# - HEALTH_CHECK_INTERVAL monitora stato sistema
#
# ENVIRONMENTS:
# development: FEED_CHECK_INTERVAL=300, LOG_LEVEL=DEBUG
# testing: FEED_CHECK_INTERVAL=900, CACHE_TIMEOUT=120  
# production: FEED_CHECK_INTERVAL=1800, CACHE_TIMEOUT=300 